# ===== Banco (Neon) =====
# Use a connection string do branch "dev" no desenvolvimento e do branch "main" (produção) na Vercel.
# Use a string COM pooling (-pooler) para o app e a SEM pooling para migrações.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/levaja?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/levaja?sslmode=require

# ===== Autenticação (Neon Auth / Managed Better Auth) =====
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech/levaja/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais

# ===== Armazenamento privado (Neon Object Storage ou qualquer S3) =====
S3_ENDPOINT=https://storage.neon.tech
S3_REGION=auto
S3_BUCKET=levaja-privado
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===== Pagamentos =====
# mock = desenvolvimento (botão "simular pagamento"); mercadopago = produção
PAYMENT_GATEWAY=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ===== Código de verificação do celular =====
# SMS: escolha um provedor (twilio, zenvia ou infobip). Sem provedor, o código vai para o log
# e, com MODO_TESTE=1, aparece na tela.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ZENVIA_API_TOKEN=
ZENVIA_FROM=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_FROM=LevaJa
# WhatsApp: infobip ou meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=
INFOBIP_WHATSAPP_FROM=
INFOBIP_WHATSAPP_TEMPLATE=
INFOBIP_WHATSAPP_LANG=pt_BR
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== Rotinas agendadas =====
# A Vercel envia "Authorization: Bearer $CRON_SECRET" nas chamadas de cron
CRON_SECRET=troque-este-segredo

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lista de e-mails que viram Gestor no primeiro login (separados por vírgula)
GESTORES_INICIAIS=
